"""
def tokenize(text):
    # \w+ — слово из букв/цифр/подчёркиваний, [—-] — дефис внутри слова
    # |[.!?—] — отдельные знаки препинания
    pattern = r"[\w]+(?:-[а-яё]+)?|[.!?—]"
    tokens = re.findall(pattern, text, flags=re.IGNORECASE)
    return tokens

tokens = tokenize(TEXT)
print(f"Всего токенов: {len(tokens)}")
print(f"Первые 20: {tokens[:20]}")
model = defaultdict(list)

for i in range(len(tokens) - 1):
    current_word = tokens[i]
    next_word = tokens[i + 1]
    model[current_word].append(next_word)
def generate_nonsense(start_word=None, length=40):
    """
    start_word — с какого слова начать (если None — случайное).
    """
    if start_word is None or start_word not in model:
        start_word = random.choice(list(model.keys()))

    result = [start_word]
    current = start_word

    for _ in range(length - 1):
        if current not in model:
            break
        next_word = random.choice(model[current])
        result.append(next_word)
        current = next_word
    text = " ".join(result)
    text = re.sub(r"\s+([.!?,—])", r"\1", text)
    # Делаем первую букву заглавной
    text = text[0].upper() + text[1:] if text else text
    if text and text[-1] not in ".!?":
        text += "."
 return text
print("\n=== ГЕНЕРАТОР БРЕДА ПО ГАЙДАРУ ===\n")
for i in range(5):
    print(f"--- Вариант {i+1} ---")
    print(generate_nonsense(length=25))
    print()
